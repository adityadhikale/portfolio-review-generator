# Copy this file to .env and fill in the values. .env is ignored by git - never commit a real key.
#
# Used only by the automatic narrative provider (slides 2-5 and 15). With narrative_provider = "manual"
# in config/settings.json, nothing here is read and the run makes no network calls.

# Which service writes the narrative
NARRATIVE_PROVIDER=

# The API key for that service
NARRATIVE_API_KEY=


NARRATIVE_MODEL=

# ---------------------------------------------------------------------------
# Universal Sheet on Google Sheets (read and written through a service account).
# Leave UNIVERSAL_SHEET_ID blank to use the local file templates\universal-sheet.xlsx instead.

# The long code in the sheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
UNIVERSAL_SHEET_ID=

# The tab that holds the stocks (default: Universal)
UNIVERSAL_WORKSHEET=Universal

# The service-account key file (keep it in secrets\, which git ignores)
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json

# ---------------------------------------------------------------------------
# Web search for AI research (Sector, Result Line, Commentary). Free plan: 1,000 searches a month at
# app.tavily.com. Without it, only blank Sectors are filled.
TAVILY_API_KEY=
