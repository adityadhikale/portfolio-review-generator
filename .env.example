# Copy this file to .env and fill in the values. .env is ignored by git - never commit a real key.
#
# Used only by the automatic narrative provider (slides 2-5 and 15). With narrative_provider = "manual"
# in config/settings.json, nothing here is read and the run makes no network calls.

# Which service writes the narrative
NARRATIVE_PROVIDER=

# The API key for that service
NARRATIVE_API_KEY=


NARRATIVE_MODEL=
