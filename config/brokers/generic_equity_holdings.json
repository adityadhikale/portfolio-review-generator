{
  "name": "generic_equity_holdings",
  "description": "Works for most broker holdings exports. The header row is found automatically (first 25 rows): it is the row that has a quantity column, an average/cost price column and a symbol, ISIN or company-name column. 'columns' are exact header names (case and punctuation ignored); 'keywords' are matched as whole words inside a header when no exact name fits; 'exclude' stops wrong matches (e.g. 'Long Term Qty' is not the quantity).",
  "header_search_rows": 25,
  "columns": {
    "symbol":         ["SYMBOL", "Symbol", "Stock Symbol", "Trading Symbol", "Tradingsymbol", "Scrip", "Scrip Code", "Ticker", "Instrument", "Stock Code", "Security ID", "NSE Symbol"],
    "isin":           ["ISIN", "ISIN Code", "ISIN No", "ISIN Number"],
    "name":           ["Company Name", "Name", "Security Name", "Scrip Name", "Stock Name", "Name of Security", "Company", "Security", "Stock", "Instrument Name"],
    "quantity":       ["QTY", "Qty", "Quantity", "Qty.", "Net Qty", "Quantity Available", "Available Qty", "Total Qty", "Holding Qty", "Free Qty", "No of Shares", "Shares", "Units", "Balance"],
    "avg_price":      ["AVG PRICE", "Avg. Price", "Average Price", "Average Cost Price", "Avg Cost", "Avg. Cost", "Avg Cost Price", "Buy Avg", "Buy Avg Price", "Average Buy Price", "Purchase Price", "Cost Price", "Rate"],
    "ltp":            ["LTP", "Last Price", "Current Market Price", "CMP", "Close Price", "Closing Price", "Market Price", "Current Price", "Last Traded Price"],
    "invested_value": ["INVESTMENT VALUE", "Invested Value", "Value At Cost", "Investment Amount", "Invested Amount", "Buy Value", "Cost Value", "Total Cost", "Purchase Value", "Amount Invested"],
    "exchange":       ["Exchange", "EXCH", "Exch"]
  },
  "keywords": {
    "isin":           ["isin"],
    "symbol":         ["symbol", "scrip code", "ticker", "tradingsymbol"],
    "quantity":       ["qty", "quantity", "shares", "units"],
    "avg_price":      ["avg", "average", "cost price", "buy price", "purchase price"],
    "ltp":            ["ltp", "cmp", "market price", "last price", "close price", "current price"],
    "invested_value": ["value at cost", "investment value", "invested", "buy value", "cost value"],
    "name":           ["company", "security name", "scrip name", "stock name", "name"]
  },
  "exclude": {
    "quantity":       ["long term", "pledged", "blocked", "t1", "collateral", "short term", "sold", "realised", "realized", "price", "value"],
    "avg_price":      ["value", "p&l", "%", "change", "total"],
    "ltp":            ["%", "change", "value"],
    "invested_value": ["%", "p&l", "profit", "loss"],
    "name":           ["isin", "exchange", "code"]
  },
  "asof_regex": "as on\\s+(\\d{4}-\\d{1,2}-\\d{1,2}|\\d{1,2}[/-]\\d{1,2}[/-]\\d{4})"
}
